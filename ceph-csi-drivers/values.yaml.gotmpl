# Rook-compatible default values for the ceph-csi-drivers Helm chart.
#
# Use these values when installing or upgrading the ceph-csi-drivers chart
# alongside the rook-ceph operator chart. The driver names must match the
# provisioner names used by Rook (e.g. in StorageClasses and VolumeSnapshotClasses).
#
# If the Rook operator is installed in a namespace other than rook-ceph, replace
# "rook-ceph" in the driver names below with your operator namespace.

# NOTE: driver.yaml renders `nodePlugin.resources.<container> | default dict`, so
# omitting a container emits an explicit `{}` into the CR, which can wipe the
# operator's built-in sidecar defaults. Every container is therefore listed
# explicitly so the requests are deterministic and visible to the scheduler.
operatorConfig:
  namespace: rook-ceph # namespace:operator
  driverSpecDefaults:
    imageSet:
      name: rook-csi-operator-image-set-configmap
    nodePlugin:
      priorityClassName: system-node-critical
      resources:
        registrar:
          requests: {cpu: 5m, memory: 16Mi}
          limits: {memory: 64Mi}
        liveness:
          requests: {cpu: 5m, memory: 16Mi}
          limits: {memory: 64Mi}
        logRotator:
          requests: {cpu: 5m, memory: 16Mi}
          limits: {memory: 64Mi}
        addons:
          requests: {cpu: 5m, memory: 16Mi}
          limits: {memory: 64Mi}
        plugin:
          requests: {cpu: 20m, memory: 64Mi}
          limits: {memory: 512Mi}
    controllerPlugin:
      priorityClassName: system-cluster-critical
      resources:
        attacher:
          requests: {cpu: 10m, memory: 32Mi}
          limits: {memory: 128Mi}
        snapshotter:
          requests: {cpu: 10m, memory: 32Mi}
          limits: {memory: 128Mi}
        resizer:
          requests: {cpu: 10m, memory: 32Mi}
          limits: {memory: 128Mi}
        provisioner:
          requests: {cpu: 10m, memory: 32Mi}
          limits: {memory: 128Mi}
        omapGenerator:
          requests: {cpu: 10m, memory: 32Mi}
          limits: {memory: 128Mi}
        liveness:
          requests: {cpu: 5m, memory: 16Mi}
          limits: {memory: 64Mi}
        logRotator:
          requests: {cpu: 5m, memory: 16Mi}
          limits: {memory: 64Mi}
        addons:
          requests: {cpu: 5m, memory: 16Mi}
          limits: {memory: 64Mi}
        plugin:
          requests: {cpu: 50m, memory: 64Mi}
          limits: {memory: 256Mi}

drivers:
  rbd:
    enabled: true
    name: rook-ceph.rbd.csi.ceph.com # csi-provisioner-name
  cephfs:
    enabled: true
    name: rook-ceph.cephfs.csi.ceph.com # csi-provisioner-name
  nfs:
    enabled: false
    name: rook-ceph.nfs.csi.ceph.com # csi-provisioner-name
  nvmeof:
    enabled: false
    name: rook-ceph.nvmeof.csi.ceph.com # csi-provisioner-name
