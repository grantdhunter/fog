env:
  TZ: America/Edmonton
  DOCKER_MODS: linuxserver/mods:universal-calibre

# k8s-home-lab common lib: resources is top-level (see charts/common/templates/lib/controller/_container.tpl)
resources:
  requests:
    cpu: 20m
    memory: 128Mi
  limits:
    memory: 768Mi
ingress:
  main:
    enabled: true
    hosts:
      - host: calibre.incngrnt.ca
        paths:
        - path: /
    tls:
      - secretName: calibre-incngrnt-ca-tls
        hosts:
          - calibre.incngrnt.ca

persistence:
  config:
    enabled: true
    accessMode: ReadWriteOnce
    size: 1Gi
    storageClassName: ceph-block      
  books:
    enabled: true
    accessMode: ReadWriteOnce
    size: 1Gi
    storageClassName: ceph-block      
