auth:
  rootPassword: {{ requiredEnv "MARIADB_ROOT_PASSWORD" }}

persistent:
  size: 5Gi

primary:
  resources:
    requests:
      cpu: 50m
      memory: 96Mi
    limits:
      # ephemeral-storage request removed - see ghost values note; the LimitRange
      # default/max covers it. Memory limit raised: 192Mi was tight for a 5Gi
      # dataset with the default key buffer + per-connection buffers.
      memory: 512Mi
