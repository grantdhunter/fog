k8up:
  envVars:
    - name: BACKUP_GLOBAL_CONCURRENT_BACKUP_JOBS_LIMIT
      values: 1
    - name: BACKUP_GLOBAL_CONCURRENT_CHECK_JOBS_LIMIT
      values: 1
    - name: BACKUP_GLOBAL_CONCURRENT_PRUNE_JOBS_LIMIT
      values: 1
  resources:
    requests:
      cpu: 10m
      memory: 64Mi
    limits:
      # memory limit == request meant any spike (e.g. a reconcile of many
      # Schedules) OOMKilled the controller. Leave headroom; CPU is uncapped
      # because CPU limits do not affect scheduling and only throttle.
      memory: 192Mi
